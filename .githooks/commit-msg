#!/usr/bin/env bash
# Запрет трейлеров соавторства от инструментов (правило 2026-09-02):
# автором коммита является только оператор. История уже очищена
# (см. docs/AUTHORSHIP-PLAN.md, вариант B); этот hook не даёт трейлерам
# вернуться. Подключение: git config core.hooksPath .githooks
set -euo pipefail

MSG_FILE="$1"
if grep -qiE '^Co-[Aa]uthored-[Bb]y:.*(claude|anthropic|copilot|cursor|codex|kimi|noreply@anthropic\.com)' "$MSG_FILE"; then
    echo "commit-msg hook: трейлер Co-Authored-By от инструмента запрещён" >&2
    echo "(правило 2026-09-02, docs/AUTHORSHIP-PLAN.md). Убери трейлер из сообщения." >&2
    exit 1
fi
