<!-- Hairline between rows inside a grouped card: the separator line is
     inset 16dp from the start, the inset area is filled with the card
     color so the screen background cannot bleed through the 1px strip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_card_bg" />
        </shape>
    </item>
    <item android:start="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_separator" />
        </shape>
    </item>
</layer-list>
