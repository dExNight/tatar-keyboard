<!-- Back chevron "<" for settings screens: app_chevron mirrored and
     scaled up to navigation size. Own two-line path, not an SF Symbol.
     Tinted with the accent so light/dark resolve via values-night. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="20dp"
    android:viewportWidth="12"
    android:viewportHeight="20"
    android:autoMirrored="true"
    android:tint="@color/app_accent">
    <path
        android:pathData="M10,2 L2,10 L10,18"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
