<!-- SetupActivity-local iOS palette (IOS-REDESIGN.md D6). Kept in this
     dedicated file, NOT colors.xml, so the parallel design-system work on
     app_* tokens cannot collide with these. Light values here; dark in
     values-night/setup_colors.xml. -->
<resources>
    <!-- Grouped-table screen background -->
    <color name="setup_screen_bg">#F2F2F7</color>
    <!-- Step-card / test-field fill -->
    <color name="setup_card">#FFFFFF</color>
    <!-- iOS system blue: filled primary buttons and the borderless action -->
    <color name="setup_accent">#007AFF</color>
    <!-- Faded accent for a disabled filled button (completed / locked step) -->
    <color name="setup_accent_disabled">#66007AFF</color>
</resources>
