<!-- Navigation row for the settings screens: title (+ optional summary)
     with a disclosure chevron. The card background (single/top/middle/
     bottom) is assigned by SettingsHostActivity based on the row's
     position in its group; the foreground ripple keeps tap feedback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            style="@style/AppText.Cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/app_text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/app_chevron"
        android:importantForAccessibility="no" />
</LinearLayout>
