<!-- Two-step onboarding (SETUP-01). Classic View/XML on purpose: no new
     dependencies, system Material widgets under platformSettingsTheme,
     visually consistent with SettingsActivity (not the iOS keyboard skin). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/english_ime_name"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="@string/setup_subtitle"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <!-- Step 1 card: enable the keyboard in system settings -->
        <LinearLayout
            android:id="@+id/setup_step1_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/setup_step1_status"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="@string/setup_step1_number"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_step1_title"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <!-- Text is set in SetupActivity: the string takes the
                     keyboard name as a format argument. -->
                <TextView
                    android:id="@+id/setup_step1_instruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <Button
                    android:id="@+id/setup_step1_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_step1_button" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2 card: select the keyboard via the system picker -->
        <LinearLayout
            android:id="@+id/setup_step2_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="?android:attr/colorBackgroundFloating"
            android:elevation="2dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/setup_step2_status"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="@string/setup_step2_number"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_step2_title"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/setup_step2_instruction"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <Button
                    android:id="@+id/setup_step2_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_step2_button" />
            </LinearLayout>
        </LinearLayout>

        <!-- Done block: both steps complete -->
        <LinearLayout
            android:id="@+id/setup_done_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_done_title"
                android:textAppearance="?android:attr/textAppearanceLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_done_hint"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <!-- Try-it field: the moment of victory — the freshly selected
                 keyboard opens right here. The hint is also the field's
                 TalkBack label (no contentDescription on an EditText). -->
            <EditText
                android:id="@+id/setup_test_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/setup_test_field_hint"
                android:imeOptions="actionDone"
                android:inputType="text" />

            <!-- Borderless: secondary next to the try-it field above. -->
            <Button
                android:id="@+id/setup_done_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_done_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
