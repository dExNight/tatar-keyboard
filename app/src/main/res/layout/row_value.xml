<!-- Value row: title with the current value on the trailing side in the
     secondary color. Tapping the row opens the seek-bar AlertDialog
     (SeekBarDialogHelper), which writes the pref and refreshes the value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/row_title"
        style="@style/AppText.Cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/row_value"
        style="@style/AppText.Cell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text_secondary" />
</LinearLayout>
