<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+0444: "ф" CYRILLIC SMALL LETTER EF -->
    <Key
        latin:keySpec="&#x0444;" />
    <!-- U+044B: "ы" CYRILLIC SMALL LETTER YERU -->
    <Key
        latin:keySpec="&#x044B;" />
    <!-- U+0432: "в" CYRILLIC SMALL LETTER VE -->
    <Key
        latin:keySpec="&#x0432;" />
    <!-- U+0430: "а" CYRILLIC SMALL LETTER A; long-press U+04D9: "ә" -->
    <Key
        latin:keySpec="&#x0430;"
        latin:moreKeys="&#x04D9;" />
    <!-- U+043F: "п" CYRILLIC SMALL LETTER PE -->
    <Key
        latin:keySpec="&#x043F;" />
    <!-- U+0440: "р" CYRILLIC SMALL LETTER ER -->
    <Key
        latin:keySpec="&#x0440;" />
    <!-- U+043E: "о" CYRILLIC SMALL LETTER O; long-press U+04E9: "ө" -->
    <Key
        latin:keySpec="&#x043E;"
        latin:moreKeys="&#x04E9;" />
    <!-- U+043B: "л" CYRILLIC SMALL LETTER EL -->
    <Key
        latin:keySpec="&#x043B;" />
    <!-- U+0434: "д" CYRILLIC SMALL LETTER DE -->
    <Key
        latin:keySpec="&#x0434;" />
    <!-- U+0436: "ж" CYRILLIC SMALL LETTER ZHE; long-press U+0497: "җ" -->
    <Key
        latin:keySpec="&#x0436;"
        latin:moreKeys="&#x0497;" />
    <!-- U+044D: "э" CYRILLIC SMALL LETTER E; long-press U+04D9: "ә" -->
    <Key
        latin:keySpec="&#x044D;"
        latin:moreKeys="&#x04D9;" />
</merge>
